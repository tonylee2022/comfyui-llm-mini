{
  "LLMMiniApiChat": {
    "display_name": "API 聊天",
    "inputs": {
      "provider": { "name": "提供商" },
      "model_name": { "name": "模型" },
      "system_prompt": { "name": "系统提示词" },
      "user_prompt": { "name": "用户提示词" },
      "history_json": { "name": "历史记录 JSON" },
      "temperature": { "name": "温度" },
      "max_tokens": { "name": "最大 Token" },
      "is_locked": { "name": "锁定缓存", "tooltip": "开启时相同输入不会重复执行；关闭时每次都会重新请求。" },
      "retain_images_in_history": { "name": "历史保留图像", "tooltip": "默认关闭，以避免 Base64 图像使历史记录和工作流文件过大。" },
      "system_prompt_input": { "name": "加载人格面具" },
      "thinking_level": { "name": "思考级别" },
      "images": { "name": "参考图像", "tooltip": "可选参考图（支持多张图或图像批次）。连接后会自动增加新的图像输入。" },
      "image_url": { "name": "图像 URL" },
      "stream": { "name": "流式输出" },
      "local_unload_policy": { "name": "本地模型卸载策略", "tooltip": "仅用于 llama.cpp：执行后卸载、保持驻留或空闲后卸载。" }
    },
    "outputs": {
      "0": { "name": "助手回复" },
      "1": { "name": "历史记录 JSON" }
    }
  },
  "LLMMiniLoadPersona": {
